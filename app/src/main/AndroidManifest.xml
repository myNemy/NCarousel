<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Dialog di sistema per escludere l’app dalle ottimizzazioni batteria (WorkManager affidabile). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />
    <!-- Nextcloud SSO (AccountImporter / Files app bridge). -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <!-- Package visibility for Nextcloud Files (SSO). Merged again from the SSO library. -->
    <queries>
        <package android:name="com.nextcloud.client" />
        <package android:name="com.nextcloud.android.beta" />
        <package android:name="com.nextcloud.android.qa" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NCarousel"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NCarousel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nextcloud Files SSO import trampoline (AccountImporter multi-step flow). -->
        <activity
            android:name=".sso.ImportSsoAccountActivity"
            android:exported="false"
            android:theme="@style/Theme.NCarousel.Transparent" />

        <service
            android:name=".quicksettings.NextWallpaperTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_next_wallpaper"
            android:label="@string/qs_tile_wallpaper_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="dev.nemeyes.ncarousel.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
